<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.foundry4j</groupId>
        <artifactId>quarkforge-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>quarkforge-excel</artifactId>
    <name>QuarkForge :: Excel</name>
    <description>Streaming Excel/CSV reading with row-level validation and error reporting, plus
        memory-safe streaming export
    </description>

    <dependencies>
        <dependency>
            <groupId>io.github.foundry4j</groupId>
            <artifactId>quarkforge-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.foundry4j</groupId>
            <artifactId>quarkforge-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <!-- REST download/upload helpers -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus.resteasy.reactive</groupId>
            <artifactId>resteasy-reactive-common</artifactId>
        </dependency>
        <!-- Route POI's Log4j API calls to the Quarkus JBoss LogManager instead of spamming stderr -->
        <dependency>
            <groupId>org.jboss.logmanager</groupId>
            <artifactId>log4j2-jboss-logmanager</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
