<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.foundry4j</groupId>
        <artifactId>quarkforge-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>quarkforge-degrade</artifactId>
    <name>QuarkForge Degrade</name>
    <description>Fault tolerance for QuarkForge: @Retry/@CircuitBreaker/@Timeout/@Bulkhead/@Fallback wired into the unified Result error model</description>

    <dependencies>
        <dependency>
            <groupId>io.github.foundry4j</groupId>
            <artifactId>quarkforge-core</artifactId>
        </dependency>
        <!-- SmallRye Fault Tolerance：提供 @Retry/@CircuitBreaker/@Timeout/@Bulkhead/@Fallback -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-fault-tolerance</artifactId>
        </dependency>
        <!-- FT 基础设施异常 → 统一 Result 响应的 ExceptionMapper -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <!-- Result 实体的 JSON 序列化（quarkus-rest 默认只有文本写入器） -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
