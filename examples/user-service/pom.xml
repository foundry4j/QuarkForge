<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.tuyucheng777</groupId>
        <artifactId>quarkforge-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>quarkforge-sample-user-service</artifactId>
    <name>QuarkForge :: Examples :: User Service</name>
    <description>Sample microservice built on QuarkForge: user CRUD, JWT login and rate limiting</description>

    <dependencies>
        <dependency>
            <groupId>io.github.tuyucheng777</groupId>
            <artifactId>quarkforge-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tuyucheng777</groupId>
            <artifactId>quarkforge-data</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tuyucheng777</groupId>
            <artifactId>quarkforge-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tuyucheng777</groupId>
            <artifactId>quarkforge-ratelimit</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tuyucheng777</groupId>
            <artifactId>quarkforge-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
